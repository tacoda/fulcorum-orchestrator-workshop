# Copy to .env and fill in. .env is gitignored — never commit a real key.
# WS4 is on the LangChain ecosystem (like WS2), so it needs an API key — there's
# no subscription-token path here (that was WS3's stock harnesses).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Workers run cheap (there are N of them at once); the
# lead and synthesizer run smart (they exercise judgment).
# WORKER_MODEL=claude-haiku-4-5-20251001
# LEAD_MODEL=claude-sonnet-5

# The most important bound in a fan-out: how many subtasks the lead may spawn.
# N parallel workers is N times the cost — cap it.
MAX_SUBTASKS=5
